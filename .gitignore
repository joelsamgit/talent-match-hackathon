# =============================================================================
# Root .gitignore — Only allow jd_analytics/ folder to be tracked/pushed
# =============================================================================

# Ignore everything in the root workspace by default
/*

# Whitelist root .gitignore file
!/.gitignore

# Whitelist ONLY the jd_analytics module folder
!/jd_analytics/

# -----------------------------------------------------------------------------
# Existing General Rules & Safeguards
# -----------------------------------------------------------------------------

# Secrets — NEVER commit .env files
.env
*.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Dependencies
node_modules/
.pnp
.pnp.js

# Build outputs
dist/
build/
.next/
out/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS & IDE
.DS_Store
Thumbs.db
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# TypeScript & Misc
*.tsbuildinfo
.cache/
coverage/
